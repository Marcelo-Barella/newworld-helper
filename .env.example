# Public port exposed by docker-compose (web + proxied /api and /mcp)
PUBLIC_PORT=8080

# Internal API service (used by web proxy and direct dev)
API_HOST=api
API_PORT=4000
NUXT_PUBLIC_API_BASE=/api/v1

# Path to versioned JSON datasets (absolute or relative to repo root)
DATA_DIR=./data

# Node environment
NODE_ENV=development